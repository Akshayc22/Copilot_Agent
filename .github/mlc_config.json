{
    "ignorePatterns": [
        {
            "pattern": "^https://your-org.com"
        },
        {
            "pattern": "^https://github.com/your-org"
        },
        {
            "pattern": "^mailto:"
        }
    ],
    "replacementPatterns": [
        {
            "pattern": "^/",
            "replacement": "{{BASEURL}}/"
        }
    ],
    "httpHeaders": [
        {
            "urls": [
                "https://github.com"
            ],
            "headers": {
                "Accept": "text/html"
            }
        }
    ],
    "timeout": "10s",
    "retryOn429": true,
    "retryCount": 3,
    "fallbackRetryDelay": "30s"
}